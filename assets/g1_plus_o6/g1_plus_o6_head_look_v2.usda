    over "Materials"
    {
        over "HeadLook"
        {
            over "BlueDiffuserEdge"
            {
                over "Surface"
                {
                    color3f inputs:emissiveColor = (0.013499999, 0.285, 1.005)
                }
            }

            over "BlueDiffuserCore"
            {
                over "Surface"
                {
                    color3f inputs:emissiveColor = (0.022499999, 0.69, 2.3249998)
                }
            }

            def Material "OpticGlass"
            {
                token outputs:surface.connect = </g1_plus_o6/Materials/HeadLook/OpticGlass/Surface.outputs:surface>

                def Shader "Surface"
