                    uniform token info:id = "UsdPreviewSurface"
                    float inputs:clearcoat = 0.45
                    float inputs:clearcoatRoughness = 0.09
                    color3f inputs:diffuseColor = (0.013, 0.024, 0.039)
                    float inputs:metallic = 0.28
                    float inputs:roughness = 0.115
